# ─────────────────────────────────────────────────────────────────────────────
# Toate variabilele sunt validate la pornire (src/config/environment-variables.ts).
# Cele marcate cu (*) sunt obligatorii; restul au valori implicite rezonabile.
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV="development"
APP_NAME="Nest Auth"
# Adresa de bind HTTP. În Docker / Render trebuie 0.0.0.0, nu localhost.
APP_HOST="0.0.0.0"
APP_URL="0.0.0.0"
APP_PORT=5000
API_PREFIX="api"
API_VERSION="1"
# În development documentația e activă automat; în production trebuie cerută explicit.
SWAGGER_ENABLED=true
# Activează `trust proxy` — necesar în spatele unui reverse proxy / load balancer.
TRUST_PROXY=false

# CORS — una sau mai multe origini, separate prin virgulă
CORS_ORIGIN="http://localhost:3000"

# Database (*)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_nest?schema=public"

# Hashing (10-15; mai mare = mai lent și mai sigur)
BCRYPT_SALT=12

# Cookies (*) — minim 32 de caractere: `openssl rand -base64 32`
COOKIE_SECRET="MclVNBkm6O/e0BHn/QARlCQqIGWheURIMM4zQe5X/BA="

# Session (*) SESSION_SECRET — minim 32 de caractere
SESSION_SECRET="CXm4xDttmLzE8BuRT/1cgsvFJSTs2UshZKeCPuuLVpI="
SESSION_NAME="sessionId"
SESSION_DOMAIN="localhost"
SESSION_MAX_AGE="30d"
# Obligatoriu `true` în production (cookie trimis doar pe HTTPS)
SESSION_SECURE=false
SESSION_SAME_SITE="lax"
SESSION_FOLDER="sessions:"

# Redis (*) REDIS_HOST
REDIS_USER="default"
REDIS_PASSWORD=""
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT="10s"

# Mail — lăsate goale, fluxurile de email eșuează la trimitere
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER="adresa_ta@gmail.com"
MAIL_PASSWORD=""
MAIL_FROM="Numele Tău <adresa_ta@gmail.com>"

# Cloudinary — necesar doar pentru upload-ul de avatare
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Coduri OTP (verificare email / resetare parolă)
# TOKEN_SECRET este opțional; implicit se refolosește SESSION_SECRET.
TOKEN_SECRET=""
TOKEN_LENGTH=6
TOKEN_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_TOKEN_TTL="5m"
PASSWORD_RESET_TOKEN_TTL="5m"

# Upload
AVATAR_MAX_SIZE_MB=2

# Rate limiting (praguri globale; endpoint-urile sensibile le restrâng suplimentar)
# short  = anti-burst (ex. login)
# medium = fereastră scurtă (ex. confirmare OTP)
# long   = anti-spam pe oră (ex. register / forgot password)
THROTTLE_SHORT_TTL="1m"
THROTTLE_SHORT_LIMIT=20
THROTTLE_MEDIUM_TTL="5m"
THROTTLE_MEDIUM_LIMIT=60
THROTTLE_LONG_TTL="1h"
THROTTLE_LONG_LIMIT=100
